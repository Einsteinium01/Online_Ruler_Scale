---
import { LANGUAGES } from '../../lib/i18n';
---

<div class="relative" id="lang-picker-root">
	<button
		type="button"
		id="lang-picker-btn"
		class="toolbar-btn"
		title="Change language"
		aria-label="Change language"
		aria-haspopup="listbox"
		aria-expanded="false"
	>
		<svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
			<circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.3"/>
			<path d="M8 1.5C8 1.5 5.5 4 5.5 8s2.5 6.5 2.5 6.5M8 1.5C8 1.5 10.5 4 10.5 8S8 14.5 8 14.5M1.5 8h13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
		</svg>
	</button>

	<div
		id="lang-picker-popover"
		hidden
		role="listbox"
		aria-label="Select language"
		class="absolute right-0 top-full mt-2 min-w-[9rem] rounded-lg border border-hairline bg-canvas p-1 shadow-level-4 z-50"
	>
		{
			LANGUAGES.map((lang) => (
				<button
					type="button"
					role="option"
					data-lang={lang.code}
					class="lang-option flex w-full items-center gap-2 rounded-md px-3 py-1.5 text-body-sm text-body hover:bg-canvas-soft-2 hover:text-ink"
				>
					<span aria-hidden="true">{lang.flag}</span>
					<span>{lang.label}</span>
				</button>
			))
		}
	</div>
</div>

<style>
	.toolbar-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: var(--radius-pill);
		color: var(--color-body);
	}
	.toolbar-btn:hover {
		background-color: var(--color-canvas-soft-2);
		color: var(--color-ink);
	}
	.lang-option[aria-selected='true'] {
		background-color: var(--color-canvas-soft-2);
		color: var(--color-ink);
		font-weight: 500;
	}
</style>

<script>
	import { translations, DEFAULT_LANG, type LangCode } from '../../lib/i18n';

	const STORAGE_KEY = 'preferred-lang';

	function getLang(): LangCode {
		try {
			const stored = localStorage.getItem(STORAGE_KEY) as LangCode | null;
			if (stored && stored in translations) return stored;
		} catch {}
		// Try browser language
		const browserLang = navigator.language?.slice(0, 2).toLowerCase();
		const supported: LangCode[] = ['en', 'pt', 'es', 'ru'];
		if (browserLang && supported.includes(browserLang as LangCode)) {
			return browserLang as LangCode;
		}
		return DEFAULT_LANG;
	}

	function setLang(lang: LangCode) {
		try {
			localStorage.setItem(STORAGE_KEY, lang);
		} catch {}
		applyTranslations(lang);
		updateActiveOption(lang);
		closePopover();
		// Dispatch so other components can react
		document.dispatchEvent(new CustomEvent('lang-change', { detail: { lang } }));
	}

	function applyTranslations(lang: LangCode) {
		const t = translations[lang];
		// Apply all data-i18n attributes
		document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
			const key = el.dataset.i18n as keyof typeof t;
			if (key && key in t) {
				el.textContent = t[key];
			}
		});
		// Apply placeholder attributes
		document.querySelectorAll<HTMLElement>('[data-i18n-placeholder]').forEach((el) => {
			const key = el.dataset.i18nPlaceholder as keyof typeof t;
			if (key && key in t) {
				(el as HTMLInputElement).placeholder = t[key];
			}
		});
		// Update html lang
		document.documentElement.lang = lang;
	}

	function updateActiveOption(lang: LangCode) {
		document.querySelectorAll<HTMLElement>('[data-lang]').forEach((btn) => {
			btn.setAttribute('aria-selected', btn.dataset.lang === lang ? 'true' : 'false');
		});
	}

	// Popover open/close
	const btn = document.getElementById('lang-picker-btn');
	const popover = document.getElementById('lang-picker-popover');

	function openPopover() {
		popover?.removeAttribute('hidden');
		btn?.setAttribute('aria-expanded', 'true');
	}

	function closePopover() {
		popover?.setAttribute('hidden', '');
		btn?.setAttribute('aria-expanded', 'false');
	}

	function togglePopover() {
		if (popover?.hasAttribute('hidden')) {
			openPopover();
		} else {
			closePopover();
		}
	}

	btn?.addEventListener('click', (e) => {
		e.stopPropagation();
		togglePopover();
	});

	document.addEventListener('click', (e) => {
		const root = document.getElementById('lang-picker-root');
		if (root && !root.contains(e.target as Node)) {
			closePopover();
		}
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closePopover();
	});

	// Language option clicks
	document.querySelectorAll<HTMLElement>('[data-lang]').forEach((optBtn) => {
		optBtn.addEventListener('click', () => {
			const lang = optBtn.dataset.lang as LangCode;
			if (lang) setLang(lang);
		});
	});

	// Init
	const initialLang = getLang();
	applyTranslations(initialLang);
	updateActiveOption(initialLang);
</script>
