---
interface Props {
	title: string;
	description: string;
	titleKey?: string;
	descKey?: string;
}
const { title, description, titleKey, descKey } = Astro.props;
---

<div class="rounded-lg border border-hairline bg-canvas p-6 shadow-level-1">
	<p class="text-body-md font-medium text-ink" data-i18n={titleKey}>{title}</p>
	<p class="mt-2 text-body-sm text-body" data-i18n={descKey}>{description}</p>
</div>
